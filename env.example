# App Configuration
EXPO_PUBLIC_APP_NAME=EduConnected
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_ENVIRONMENT=development

# EAS Build Configuration
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id_here

# API Configuration
EXPO_PUBLIC_BASE_URL=https://api.educonnected.com
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_API_TIMEOUT=30000

# Authentication Configuration
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# iOS Configuration
EXPO_PUBLIC_APPLE_TEAM_ID=your_apple_team_id_here
EXPO_PUBLIC_IOS_GOOGLE_URL_SCHEME=your_ios_url_scheme_here

# Android Configuration
EXPO_PUBLIC_ANDROID_PACKAGE_NAME=com.bricefrck.learningplatform.dev

# Feature Flags
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_IN_APP_PURCHASES=true
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Third Party Services
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
EXPO_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_api_key_here
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# Development Configuration
EXPO_PUBLIC_ENABLE_DEBUG_MENU=true
EXPO_PUBLIC_ENABLE_LOGGING=true
EXPO_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
