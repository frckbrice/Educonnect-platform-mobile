{
  "name": "educonnected-mobile-platform",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "A comprehensive cross-platform mobile learning management system built with React Native and Expo",
  "keywords": [
    "react-native",
    "expo",
    "typescript",
    "mobile-app",
    "learning-platform",
    "lms",
    "cross-platform",
    "education"
  ],
  "author": "Franck Brice Avom",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/franckbriceavom/educonnected-mobile-platform.git"
  },
  "homepage": "https://github.com/franckbriceavom/educonnected-mobile-platform#readme",
  "bugs": {
    "url": "https://github.com/franckbriceavom/educonnected-mobile-platform/issues"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:e2e": "node scripts/run-tests.js e2e",
    "test:watch": "node scripts/run-tests.js watch",
    "test:debug": "node scripts/run-tests.js debug",
    "test:file": "node scripts/run-tests.js file",
    "test:status": "node scripts/run-tests.js status",
    "test:setup": "node scripts/run-tests.js setup",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "clean-install": "expo r -c && rm -rf node_modules && yarn install",
    "check-logs": "node scripts/check-console-logs.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.3.1",
    "@expo/vector-icons": "^14.0.2",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@react-native/codegen": "^0.79.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@storybook/react-native": "^9.1.1",
    "@types/node": "^22.15.29",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "expo": "53.0.12",
    "expo-auth-session": "~6.2.0",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.5",
    "expo-crypto": "~14.1.4",
    "expo-dev-client": "~5.2.1",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.3.0",
    "expo-jwt": "^1.8.2",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.4",
    "expo-notifications": "~0.31.3",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.9",
    "expo-web-browser": "~14.2.0",
    "jose": "^6.0.11",
    "moment": "^2.30.1",
    "moti": "^0.30.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.4",
    "react-native-circular-progress-indicator": "^4.4.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-iap": "^12.16.2",
    "react-native-reanimated": "~3.17.4",
    "react-native-redash": "^18.1.3",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "^4.11.1",
    "react-native-size-matters": "^0.4.2",
    "react-native-status-bar-height": "^2.6.0",
    "react-native-svg": "15.11.2",
    "react-native-swiper": "^1.6.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.2",
    "@react-native/eslint-config": "^0.81.0",
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-onboarding": "^1.0.10",
    "@storybook/blocks": "^7.6.17",
    "@storybook/react": "^7.6.17",
    "@storybook/react-vite": "^7.6.17",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^9.0.11",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.6",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0",
    "yarn": ">=1.22.0"
  },
  "private": true
}
